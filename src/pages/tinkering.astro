---
import CaseStudy from '../layouts/CaseStudy.astro';

const FEED_URL = 'https://designersnotebook.substack.com/feed';

type Post = {
  title: string;
  link: string;
  date: Date;
  excerpt: string;
};

function decodeEntities(s: string): string {
  return s
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&apos;/g, "'")
    .replace(/&#8217;/g, '’')
    .replace(/&#8216;/g, '‘')
    .replace(/&#8220;/g, '“')
    .replace(/&#8221;/g, '”')
    .replace(/&#8212;/g, '—')
    .replace(/&nbsp;/g, ' ');
}

function stripCData(s: string): string {
  return s.replace(/^\s*<!\[CDATA\[/, '').replace(/\]\]>\s*$/, '').trim();
}

function stripTags(s: string): string {
  return s.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
}

function pick(xml: string, tag: string): string {
  const re = new RegExp(`<${tag}[^>]*>([\\s\\S]*?)<\\/${tag}>`, 'i');
  const m = xml.match(re);
  return m ? stripCData(m[1]) : '';
}

function truncate(s: string, n: number): string {
  if (s.length <= n) return s;
  const cut = s.slice(0, n);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > 0 ? cut.slice(0, lastSpace) : cut) + '…';
}

async function loadPosts(): Promise<Post[]> {
  try {
    // Cache-bust: Substack sits behind Cloudflare, and a cached feed at build
    // time silently publishes a stale post list.
    const res = await fetch(`${FEED_URL}?cb=${Date.now()}`, {
      headers: {
        'User-Agent': 'cansutecimer.com/rss-fetch',
        'Cache-Control': 'no-cache',
        Pragma: 'no-cache',
      },
    });
    if (!res.ok) return [];
    const xml = await res.text();
    const items = [...xml.matchAll(/<item[^>]*>([\s\S]*?)<\/item>/g)].map((m) => m[1]);
    return items.map((block) => {
      const title = decodeEntities(pick(block, 'title'));
      const link = stripTags(pick(block, 'link'));
      const pubDate = pick(block, 'pubDate');
      const description = pick(block, 'description');
      const excerpt = truncate(decodeEntities(stripTags(description)), 220);
      return {
        title,
        link,
        date: pubDate ? new Date(pubDate) : new Date(0),
        excerpt,
      };
    });
  } catch {
    return [];
  }
}

const posts = await loadPosts();

// SwitchUp Notes is a closed publication — it ran Jul–Aug 2025 and will not gain
// new posts. These four are snapshotted rather than fetched: the feed above is the
// one that has to stay current, and a build-time request to a dormant newsletter is
// a dependency with no upside. If Substack ever stops serving it, a fetch would
// silently empty this section instead of failing loudly.
const ARCHIVE_POSTS: Post[] = [
  {
    title: 'Progress Isn’t Linear (And It’s Not Supposed To Be)',
    link: 'https://switchupnotes.substack.com/p/progress-isnt-linear-and-its-not',
    date: new Date('Tue, 05 Aug 2025 08:30:43 GMT'),
    excerpt: 'How setbacks can help us achieve real change.',
  },
  {
    title: 'Why Starting Small Feels So Damn Hard',
    link: 'https://switchupnotes.substack.com/p/why-starting-small-feels-so-damn',
    date: new Date('Tue, 29 Jul 2025 08:30:34 GMT'),
    excerpt: 'And why the smarter move is to take small steps.',
  },
  {
    title: 'Your Brain Doesn’t Care About Your Goals',
    link: 'https://switchupnotes.substack.com/p/your-brain-doesnt-care-about-your',
    date: new Date('Tue, 22 Jul 2025 08:30:30 GMT'),
    excerpt: 'Why comfort always wins — and what to do about it.',
  },
  {
    title: 'I Quit My Job and Tried to Get Fitter. Here’s What Actually Helped.',
    link: 'https://switchupnotes.substack.com/p/i-quit-my-job-and-tried-to-get-fitter',
    date: new Date('Mon, 14 Jul 2025 13:34:21 GMT'),
    excerpt: 'A year ago, I quit my job.',
  },
];

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---
<CaseStudy
  title="Tinkering — Cansu Tecimer"
  description="Writing and experiments from Cansu Tecimer, syndicated from Designer's Notebook."
>

  <section class="hero container">
    <p class="eyebrow"><span class="dot"></span> Tinkering</p>
    <h1 class="display">Designer's <em>Notebook</em>.</h1>
    <p class="lede">
      Occasional writing on design, building products, and the work of leading teams. Posts are pulled from my <a href="https://designersnotebook.substack.com/" class="contact-link" target="_blank" rel="noopener">Substack</a>.
    </p>
  </section>

  <section class="story story--tight container">
    <div class="posts-list">
      {posts.length === 0 && (
        <p class="posts-empty">No posts yet — check back soon, or visit the Substack directly.</p>
      )}
      {posts.map((post) => (
        <a href={post.link} class="post-card" target="_blank" rel="noopener">
          <span class="post-date">{dateFormatter.format(post.date)}</span>
          <h2 class="post-title">{post.title}</h2>
          {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
          <span class="post-link">Read on Substack →</span>
        </a>
      ))}
    </div>

    <div class="posts-archive-head">
      <h2 class="posts-archive-title">Earlier writing</h2>
      <p class="posts-archive-note">
        From <a href="https://switchupnotes.substack.com/" class="contact-link" target="_blank" rel="noopener">SwitchUp Notes</a>, a newsletter I wrote in 2025 about habits and starting over. It's no longer updated.
      </p>
    </div>

    <div class="posts-list">
      {ARCHIVE_POSTS.map((post) => (
        <a href={post.link} class="post-card" target="_blank" rel="noopener">
          <span class="post-date">{dateFormatter.format(post.date)}</span>
          <h2 class="post-title">{post.title}</h2>
          {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
          <span class="post-link">Read on Substack →</span>
        </a>
      ))}
    </div>
  </section>

</CaseStudy>
