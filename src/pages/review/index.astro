    .ob-card { width: 345px; background: #fff; border-radius: 16px; }
    .ob-ftp { padding: 36px 24px; box-shadow: 0 0 20px rgba(0, 0, 0, .05); display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .ob-eyebrow { font-size: 12px; line-height: 18px; font-weight: 600; letter-spacing: 2px; color: #9499bb; }
    .ob-num { display: flex; align-items: baseline; gap: 8px; }
    .ob-num b { font-size: 48px; line-height: 48px; font-weight: 800; letter-spacing: -1px; background: linear-gradient(90deg, #2663eb, #7c3aed); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
    .ob-num span { font-size: 18px; font-weight: 700; color: #9499bb; }
    .ob-how { font-size: 12px; color: #9499bb; }
    .ob-btns { display: flex; gap: 12px; padding-top: 12px; }
    .ob-btn { height: 50px; width: 143px; padding: 0 12px; white-space: nowrap; border-radius: 16px; display: grid; place-items: center; font-size: 14px; font-weight: 600; transition: transform .15s; }
    .ob-btn.sec { background: #eceef8; border: 1px solid #dfe1f0; }
    .ob-btn.pri { background: #2663eb; color: #fff; }
    .ob-btn.wide { width: 310px; padding: 0; height: 40px; border-radius: 12px; }
    .ob-avail { width: 358px; padding: 24px; border: 1px solid #eceef8; box-shadow: 0 2px 16px rgba(67, 97, 238, .08); display: flex; flex-direction: column; gap: 4px; }
    .ob-at { font-size: 16px; line-height: 24px; font-weight: 700; }
    .ob-as { font-size: 14px; line-height: 22px; color: #9499bb; }
    .ob-as b { color: #2663eb; font-weight: 600; }
    .ob-bars { display: flex; gap: 12px; margin: 20px 0 24px; }
    .ob-day { width: 34px; display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 12px; line-height: 18px; font-weight: 600; }
    .ob-hl { color: #2663eb; }
    .ob-dn { color: #9499bb; }
    .ob-track { width: 34px; height: 120px; border: 1.5px solid #eceef8; border-radius: 20px; background: #f7f8fc; padding: 1.5px; display: flex; align-items: flex-end; overflow: hidden; }
    .ob-fill { width: 100%; height: 0; background: linear-gradient(180deg, #4361ee, #7b4fe0); transition: height .45s cubic-bezier(.3, .7, .3, 1); }

    /* final prototype (placeholder layout, unused) */
    .proto { display: grid; grid-template-columns: 900px 1fr; gap: 72px; align-items: center; margin-top: 64px; }
    .placeholder { height: 440px; border: 1.5px dashed #c9bff0; border-radius: 22px; background: #f1eefb; display: grid; place-content: center; text-align: center; gap: 14px; color: var(--ink-2); }
    .placeholder .tag { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
    .placeholder p { font-size: 20px; line-height: 1.45; }
    .heads { display: flex; flex-direction: column; gap: 40px; }
    .heads h3 { font-family: var(--display); font-size: 32px; font-weight: 800; letter-spacing: -.04em; }
    .heads p { font-size: 16px; line-height: 1.5; color: var(--ink-2); margin-top: 8px; }

    /* build steps: reveal one at a time when presenting; everything visible without JS */
    .js .step { opacity: 0; transform: translateY(8px); transition: opacity .4s ease, transform .4s ease; }
    .js .step.shown { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .slide, .js .step, .case { transition: none !important; } }

    /* ---------- Chrome: progress, notes, index ---------- */
    .progress { position: fixed; left: 0; bottom: 0; height: 3px; background: var(--violet); transition: width .3s ease; z-index: 5; }
    .hud { position: fixed; right: 18px; bottom: 14px; font: 500 12px/1 var(--sans); color: var(--ink-3); z-index: 5; display: flex; gap: 12px; align-items: center; }
    .hud .mode { border: 1px solid var(--line-strong); border-radius: 999px; padding: 4px 8px; background: #fff; }
    .notes { position: fixed; left: 18px; right: 18px; bottom: 18px; max-height: 38vh; overflow: auto; background: rgba(14, 15, 23, .94); color: #f1eff7; border-radius: 14px; padding: 18px 22px; font-size: 15px; line-height: 1.55; z-index: 6; }
