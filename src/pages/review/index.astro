    .jcol .when span { background: var(--paper); padding-right: 14px; position: relative; }
    .jcol .when::before { content: ''; width: 13px; height: 13px; border-radius: 50%; background: var(--violet); box-shadow: 0 0 0 4px var(--paper); flex: none; }
    .jrow { display: flex; gap: 22px; margin-top: 24px; }
    .jphone { position: relative; width: 227px; height: 470px; flex: none; border-width: 8px; border-radius: 36px; --u: calc(211px / 375); }
    .jphone .hp-scr { opacity: 1; pointer-events: auto; bottom: calc(84 * var(--u)); }
    .jphone .hp-page img, .jphone .jnav { display: block; width: 100%; height: auto; object-fit: initial; }
    .jphone .jnav { position: absolute; left: 0; bottom: 0; }
    .jneeds { padding-top: 4px; }
    .jneeds .cap { font-size: 13px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }
    .jneeds ul { list-style: none; margin-top: 10px; display: flex; flex-direction: column; gap: 8px; }
    .jneeds li { font-size: 16px; line-height: 1.4; color: var(--ink-2); }
    .jneeds li:first-child { color: var(--ink); font-weight: 700; }
    .jneeds .mod { margin-top: 26px; }
    .jneeds .mod b { display: block; margin-top: 8px; font-size: 16px; line-height: 1.4; color: var(--violet); }

    /* GYG alignment moment: real workshop photos + the path to buy-in */
    .ws { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }
    .ws img { display: block; width: 100%; aspect-ratio: 1512 / 982; object-fit: cover; border-radius: 16px; }
    .path { display: flex; align-items: center; margin-top: 44px; }
    .path .pc { flex: 1; height: 84px; border-radius: 14px; background: var(--white); border: 1.5px solid var(--line-strong); display: flex; flex-direction: column; justify-content: center; padding: 0 22px; }
    .path .pc b { font-size: 19px; font-weight: 700; }
    .path .pc small { font-size: 14px; color: var(--ink-2); margin-top: 3px; }
    .path .pc.win { background: var(--violet); border-color: var(--violet); color: #fff; box-shadow: 0 10px 28px rgba(71, 33, 251, .22); }
    .path .pc.win small { color: rgba(255, 255, 255, .8); }
    .ceo-note { position: absolute; left: 1010px; top: 796px; transform: rotate(-3deg); font-weight: 700; font-size: 34px; }
    .ceo-note svg { position: absolute; left: -58px; top: -24px; }

    /* GYG vision → MVP: two phones + decision cards */
    .v2m { display: grid; grid-template-columns: auto 1fr; gap: 64px; margin-top: 44px; align-items: start; }
    .v2m .pair { display: flex; gap: 28px; }
