    .v2m.big .jphone { width: 318px; height: 660px; border-width: 9px; border-radius: 46px; --u: calc(300px / 375); }
    .v2m.big figcaption { font-size: 16px; }
    .decisions { display: flex; flex-direction: column; gap: 16px; }
    .dcard { background: var(--white); border: 1.5px solid var(--line); border-radius: 16px; padding: 20px 24px; }
    .dcard .tagl { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; border-radius: 999px; padding: 3px 10px; }
    .tagl.kept { background: var(--violet); color: #fff; }
    .tagl.simp { background: var(--violet-soft); color: var(--hand); }
    .tagl.def { background: #ecebf2; color: var(--ink-2); }
    .dcard h4 { font-family: var(--display); font-size: 24px; font-weight: 800; letter-spacing: -.04em; margin-top: 10px; }
    .dcard p { font-size: 16px; line-height: 1.5; color: var(--ink-2); margin-top: 4px; }
    .principle { font-size: 16px; line-height: 1.5; color: var(--ink); margin-top: 6px; }
    .principle b { color: var(--violet); }
    /* stories experiments: contact sheet + verdict */
    .sheet { display: flex; gap: 24px; margin-top: 44px; align-items: flex-end; }
    .sheet figure { display: flex; flex-direction: column; align-items: center; gap: 12px; }
    .sheet .phone { width: 196px; height: 412px; border-width: 7px; border-radius: 32px; }
    .sheet .phone img { object-position: top; }
    .sheet .story { width: 232px; height: 387px; border-radius: 18px; overflow: hidden; box-shadow: 0 24px 60px rgba(29, 34, 64, .16); }
    .sheet .story img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sheet figcaption { font-size: 14px; font-weight: 700; color: var(--ink-2); }
    .sheet .count { margin-left: auto; align-self: center; text-align: right; }
    .sheet .count b { display: block; font-family: var(--display); font-size: 120px; font-weight: 900; letter-spacing: -.06em; line-height: 1; color: var(--violet); }
    .sheet .count span { font-size: 16px; color: var(--ink-2); line-height: 1.5; }
    .verdict { display: flex; align-items: center; margin-top: 40px; }
    .verdict .vc { flex: 1; height: 92px; border-radius: 14px; background: var(--white); border: 1.5px solid var(--line-strong); display: flex; flex-direction: column; justify-content: center; padding: 0 22px; }
    .verdict .vc b { font-size: 19px; font-weight: 700; }
    .verdict .vc small { font-size: 14px; color: var(--ink-2); margin-top: 3px; line-height: 1.4; }
    .verdict .vc.end { background: var(--violet); border-color: var(--violet); color: #fff; box-shadow: 0 10px 28px rgba(71, 33, 251, .22); }
    .verdict .vc.end small { color: rgba(255,255,255,.8); }

    /* stories slide: flow video + experiments */
    .inspo { display: flex; align-items: center; justify-content: space-between; flex: 1; margin-top: 10px; }
    .inspo figure { display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .inspo .ip { position: relative; width: 318px; height: 670px; border-width: 9px; border-radius: 46px; }
    .inspo .ip img, .inspo .ip video { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
    .inspo figcaption { text-align: center; display: flex; flex-direction: column; gap: 2px; }
    .inspo figcaption b { font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
    .inspo figcaption span { font-size: 18px; font-weight: 700; }
    .inspo .count { text-align: left; width: 220px; }
    .inspo .count b { display: block; font-family: var(--display); font-size: 150px; font-weight: 900; letter-spacing: -.06em; line-height: .9; color: var(--violet); }
    .inspo .count span { font-size: 16px; color: var(--ink-2); line-height: 1.5; }
    /* the first inspiration card cycling through the story, positioned in 375-wide design units */
    .tile-play { --u: calc(300px / 375); position: absolute; left: calc(16 * var(--u)); top: calc(570 * var(--u)); width: calc(123 * var(--u)); height: calc(168 * var(--u)); border-radius: 8px; overflow: hidden; }
    /* the first card plays its story: three images cycle, with story-style progress segments */
    .tile-play { top: calc(568 * var(--u)) !important; border-radius: calc(12 * var(--u)) !important; }
    .tile-play i { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; animation: tileCycle 7.5s infinite; }
    .tile-play i:nth-child(2) { animation-delay: 2.5s; }
    .tile-play i:nth-child(3) { animation-delay: 5s; }
    @keyframes tileCycle { 0% { opacity: 0; transform: scale(1.06); } 3% { opacity: 1; } 33% { opacity: 1; transform: scale(1); } 36% { opacity: 0; } 100% { opacity: 0; } }
    .tile-play::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 55%, rgba(0,0,0,.45)); }
    .tile-play b { position: absolute; left: 8px; right: 8px; bottom: 8px; z-index: 2; font-family: 'Rubik', var(--sans); font-size: 10.5px; line-height: 1.2; font-weight: 700; color: #fff; }

    /* GYG takeaways: four short lines, each with a skeleton glyph */
    .takeaways { display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px; margin: auto 0; padding-bottom: 30px; }
    .tk svg { display: block; width: 240px; height: 90px; }
    .tk h3 { font-family: var(--display); font-size: 32px; font-weight: 800; letter-spacing: -.05em; line-height: 1.1; margin-top: 34px; }
    .tk p { font-size: 16px; line-height: 1.5; color: var(--ink-2); margin-top: 12px; }

    /* closing slide: mirrors the cover */
    .closing { padding-top: 0; justify-content: center; }
    .closing .body a { color: inherit; text-decoration: none; }
    .closing .thanks-note { margin-top: 36px; font-weight: 700; font-size: 40px; transform: rotate(-3deg); }

    /* product overview */
    .slide.lavender { background: var(--panel); }
    .overview { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 64px; padding: 0 44px; }
    .overview figure { display: flex; flex-direction: column; align-items: center; gap: 26px; }
    .overview img { height: 520px; width: auto; filter: drop-shadow(0 22px 40px rgba(29, 34, 64, .14)); }
    .overview figcaption { font-size: 16px; line-height: 1.5; color: var(--ink-2); }

    /* final onboarding: four phones. App screens lay out at iPhone 16 width (393px) and are zoomed into the 280px screen
       (zoom, not transform: text re-renders at the final size and stays sharp). Images are 3x exports. */
    .final4 { display: flex; justify-content: space-between; margin-top: 91px; }
    .ob { position: relative; width: 300px; height: 620px; background: #f6f7fa; }
    .ob-ui { position: absolute; left: 0; top: 0; width: 393px; height: 842px; zoom: .71247; overflow: hidden; font-family: 'Rubik', var(--sans); color: #141824; }
    .ob-head { position: absolute; left: 0; top: 0; width: 393px; z-index: 2; pointer-events: none; }
    .ob .ob-head, .ob .ob-scroll img { height: auto; object-fit: initial; }
    .ob-scroll { position: absolute; left: 0; right: 0; top: 109px; bottom: 0; overflow-y: auto; scrollbar-width: none; }
    .ob-scroll::-webkit-scrollbar { display: none; }
    .ob-scroll img { display: block; width: 393px; }
    .ob-scr { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; transform: translateX(36px); transition: opacity .35s ease, transform .35s ease; pointer-events: none; }
    .ob-scr.on { opacity: 1; transform: none; }
    .ob-scr.off { opacity: 0; transform: translateX(-36px); }
    .ob-body { width: 393px; padding: 0 24px; display: flex; flex-direction: column; align-items: center; gap: 26px; }
    .ob-body h4 { width: 365px; font-size: 32px; line-height: 40px; font-weight: 700; letter-spacing: -.03em; text-align: center; }
    .ob-opts { width: 345px; display: flex; flex-direction: column; gap: 13.5px; }
    .ob-opt { height: 59px; display: grid; place-items: center; background: #fff; border: 1px solid #e9edf5; border-radius: 16px; box-shadow: 0 4px 16px rgba(40, 60, 99, .06); font-size: 15px; line-height: 24px; color: #515775; transition: border-color .2s, background .2s, color .2s, transform .15s; }
    .ob-opt.pick { border-color: #2663eb; background: #f3f7ff; color: #2663eb; transform: scale(.98); }
    .ob-scr.on .ob-opt { animation: obIn .4s ease both; }
    .ob-scr.on .ob-opt:nth-child(2) { animation-delay: .08s; }
    .ob-scr.on .ob-opt:nth-child(3) { animation-delay: .16s; }
    @keyframes obIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    .ob-inp { width: 345px; height: 59px; position: relative; display: flex; align-items: center; justify-content: center; background: #fff; border: 1.5px solid #dfe1f0; border-radius: 16px; box-shadow: 0 4px 24px rgba(67, 97, 238, .10); font-size: 15px; }
    .ob-caret { width: 1.5px; height: 18px; background: #2663eb; margin-left: 1px; animation: obBlink 1s steps(1) infinite; }
    @keyframes obBlink { 50% { opacity: 0; } }
    .ob-go { position: absolute; right: 12px; top: 8.5px; width: 40px; height: 40px; border-radius: 12px; background: #2663eb; display: grid; place-items: center; opacity: .3; transition: opacity .2s, transform .15s; }
    .ob-go.ready { opacity: 1; }
