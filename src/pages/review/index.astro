        <aside class="notes-src" hidden>
          <ul>
            <li><b>Communicating to earn trust:</b> the workshop, only 3 days, gave us a sound strategy we could confidently communicate to executives. That bought time and space to launch experiments and learn iteratively, with exec buy-in.</li>
            <li><b>Involving engineering early:</b> the EM helped us understand our capabilities, which made the strategy feasible and gave engineering a head start. The workshop also built context and bonded the team.</li>
            <li><b>Starting with segments &amp; diverging needs:</b> we assumed segments had distinct needs, but similar modules performed well across all of them. Leaner: start with 1–2 similar experiences and diverge through testing. We did the opposite.</li>
            <li><b>Playing to our strengths:</b> weekend getaways was grounded in research (shorter, more frequent trips), but needed different inventory and a repositioning of GetYourGuide. So we omitted it as a module.</li>
          </ul>
        </aside>
      </section>

      <!-- Close -->
      <section class="slide cover closing" id="thanks" data-title="Thank you" data-group="Close">
        <h1>Thank you.</h1>
        <p class="body">Cansu Tecimer · <a href="https://cansutecimer.com">cansutecimer.com</a></p>
        <div class="hand thanks-note">Questions?</div>
      </section>

    </main>
  </div>

  <div class="progress" id="progress"></div>
  <div class="hud" id="hud"><span class="mode" id="mode" hidden>Short version</span><span id="count"></span></div>
  <div class="notes" id="notes" hidden></div>
  <nav class="index" id="index" hidden aria-label="Slide index"></nav>

  <script is:inline>
    (() => {
      document.documentElement.classList.add('js');
      const stage = document.getElementById('stage');
      const slides = [...stage.querySelectorAll('.slide')];
      const notes = document.getElementById('notes');
      const index = document.getElementById('index');
      let cur = 0, short = false;

      const store = { get: k => { try { return localStorage.getItem(k); } catch { return null; } }, set: (k, v) => { try { localStorage.setItem(k, v); } catch {} } };
      short = store.get('deck-short') === '1';

      function fit() {
        const s = Math.min(window.innerWidth / 1600, window.innerHeight / 900);
        stage.style.transform = `translate(-50%, -50%) scale(${s})`;
      }
      const visible = () => slides.map((s, i) => i).filter(i => !(short && slides[i].dataset.deep !== undefined));
      const steps = s => [...s.querySelectorAll('.step')];

      // Address bar shows the slide's number in the full deck (#1, #2 …). Each slide change is a
      // history step, so browser back/forward moves through slides. Named anchors (#steady) still resolve.
      function show(i, { fromEnd = false, nav = 'push' } = {}) {
        cur = Math.max(0, Math.min(slides.length - 1, i));
        slides.forEach((s, j) => s.classList.toggle('is-active', j === cur));
        steps(slides[cur]).forEach(st => st.classList.toggle('shown', fromEnd));
        document.getElementById('count').textContent = `${cur + 1} / ${slides.length}`;
        document.getElementById('progress').style.width = `${((cur + 1) / slides.length) * 100}%`;
        document.getElementById('mode').hidden = !short;
        const hash = `#${cur + 1}`;
        if (location.hash !== hash) {
          if (nav === 'push') history.pushState(null, '', hash);
          else if (nav === 'replace') history.replaceState(null, '', hash);
        }
        slides.forEach((sl, j) => sl.querySelectorAll('video').forEach(v => { if (j === cur) { v.currentTime = 0; v.play().catch(() => {}); } else v.pause(); }));
        stage.querySelectorAll('.flip[aria-expanded="true"]').forEach(b => flip(b, false));
        syncFrames();
        stage.querySelectorAll('.hp').forEach(h => hpShow(h, 'str'));
        // journey phones that open part-way down (data-start, in 375-wide design units)
        stage.querySelectorAll('.hp-scr[data-start]').forEach(sc => { sc.scrollTop = +sc.dataset.start * sc.clientWidth / 375; });
        renderNotes();
      }
      // Embedded prototypes only run while visible (active slide, and their build step shown), so they start from the top
      const visibleNow = (el, j) => j === cur && (!el.closest('.step') || el.closest('.step').classList.contains('shown'));
      function syncFrames() {
        slides.forEach((sl, j) => sl.querySelectorAll('iframe[data-src]').forEach(f => {
          const want = visibleNow(f, j) ? f.dataset.src : 'about:blank';
          if (f.getAttribute('src') !== want) f.setAttribute('src', want);
        }));
        slides.forEach((sl, j) => sl.querySelectorAll('[data-live]').forEach(el => {
          const on = visibleNow(el, j);
          if (on && !el._run) { el._run = { dead: false }; live[el.dataset.live](el, el._run).catch(() => {}); }
          if (!on && el._run) { el._run.dead = true; el._run = null; resetLive(el); }
        }));
      }

      // ---- Final onboarding phones: small scripted loops ----
      const Dead = {};
      const wait = (ms, run) => new Promise((res, rej) => setTimeout(() => run.dead ? rej(Dead) : res(), ms));
      function resetLive(el) {
        el.querySelectorAll('.ob-scr').forEach(sc => sc.classList.remove('on', 'off'));
        el.querySelectorAll('.pick, .ready, .tap').forEach(n => n.classList.remove('pick', 'ready', 'tap'));
        el.querySelectorAll('.ob-val').forEach(v => v.textContent = '');
        el.querySelectorAll('.ob-fill').forEach(f => f.style.height = '0');
        el.querySelectorAll('.ob-hl').forEach(h => h.textContent = '0h');
        el.querySelectorAll('.ob-num b').forEach(b => b.textContent = '0');
        el.querySelectorAll('.ob-total').forEach(t => t.textContent = '0h total per week');
        el.querySelectorAll('.ob-scroll').forEach(sc => sc.scrollTop = 0);
      }
      function go(el, name) {
        el.querySelectorAll('.ob-scr').forEach(sc => {
          if (sc.dataset.s === name) { sc.classList.remove('off'); sc.classList.add('on'); }
          else if (sc.classList.contains('on')) { sc.classList.remove('on'); sc.classList.add('off'); }
          else sc.classList.remove('off');
        });
        return el.querySelector(`[data-s="${name}"]`);
      }
      async function tap(n, run) { n.classList.add('tap'); await wait(160, run); n.classList.remove('tap'); }
      async function type(sc, text, run) {
        const v = sc.querySelector('.ob-val'), g = sc.querySelector('.ob-go');
        v.textContent = ''; g.classList.remove('ready');
        for (const ch of text) { v.textContent += ch; g.classList.add('ready'); await wait(70, run); }
        await wait(450, run); await tap(g, run);
      }
      const live = {
        // each plays once and stays on its last state
        async event(el, run) {
          resetLive(el);
          let sc = go(el, 'type'); await wait(1600, run);
          sc.querySelector('.ob-opt').classList.add('pick'); await wait(700, run);
          sc = go(el, 'name'); await wait(600, run); await type(sc, 'Serra de Estrela', run); await wait(300, run);
          sc = go(el, 'dist'); await wait(600, run); await type(sc, '174', run); await wait(300, run);
          sc = go(el, 'obj'); await wait(1600, run);
          sc.querySelector('.ob-opt').classList.add('pick');
        },
        async athlete(el, run) {
          {
            resetLive(el);
            let sc = go(el, 'ftp'); await wait(500, run);
            const b = sc.querySelector('.ob-num b');
            for (let i = 1; i <= 24; i++) { b.textContent = Math.round(211 * (1 - Math.pow(1 - i / 24, 3))); await wait(35, run); }
            await wait(1300, run); await tap(sc.querySelector('.ob-btn.pri'), run); await wait(250, run);
            sc = go(el, 'dob'); await wait(600, run); await type(sc, '14 June 1990', run); await wait(300, run);
            sc = go(el, 'avail'); await wait(700, run);
            let tot = 0;
            for (const d of sc.querySelectorAll('.ob-day')) {
              const h = +d.dataset.h; tot += h;
              d.querySelector('.ob-fill').style.height = `${(h / 6) * 100}%`;
              d.querySelector('.ob-hl').textContent = `${h}h`;
              sc.querySelector('.ob-total').textContent = `${tot}h total per week`;
              await wait(380, run);
            }
            await wait(900, run); await tap(sc.querySelector('.ob-btn.wide'), run);
          }
        },
        async scroll(el, run) {
          const box = el.querySelector('.ob-scroll');
          let user = false;
          const stopAuto = () => { user = true; };
          box.addEventListener('wheel', stopAuto, { passive: true, once: true });
          box.addEventListener('touchstart', stopAuto, { passive: true, once: true });
          box.scrollTop = 0; await wait(1500, run);
          // float position so sub-pixel steps don't get rounded away; stops once the box can't scroll further
          let pos = 0;
          while (!user && box.scrollTop >= pos - 2) { pos += 1.2; box.scrollTop = pos; await wait(16, run); }
        },
      };
      // journey phones: apply the starting scroll once the screen image has loaded (it can't scroll before that)
      stage.querySelectorAll('.hp-scr[data-start]').forEach(sc => {
        const apply = () => { sc.scrollTop = +sc.dataset.start * sc.clientWidth / 375; };
        const img = sc.querySelector('img');
        if (img.complete) apply(); else img.addEventListener('load', apply, { once: true });
      });
      // Homepage option phones: segment switch + tap targets between screens
      function hpShow(h, name) {
        h.querySelectorAll('.hp-scr').forEach(sc => { const on = sc.dataset.scr === name; sc.classList.toggle('on', on); if (on) sc.scrollTop = 0; });
        const seg = name.split('-')[0];
        h.querySelectorAll('.hp-seg button').forEach(b => b.classList.toggle('on', b.dataset.seg === seg));
      }
      stage.querySelectorAll('.hp').forEach(h => h.addEventListener('click', e => {
        const t = e.target.closest('[data-go], [data-seg]');
        if (t) hpShow(h, t.dataset.go || t.dataset.seg);
      }));
      // Workout cards: click toggles between the collapsed and expanded export
      function flip(b, open) {
        const img = b.querySelector('img');
        if (!b.dataset.closed) b.dataset.closed = img.getAttribute('src');
        img.src = open ? b.dataset.open : b.dataset.closed;
        b.setAttribute('aria-expanded', String(open));
        b.closest('.card-slot').scrollTop = 0;
      }
      stage.querySelectorAll('.flip').forEach(b => {
        new Image().src = b.dataset.open;
        b.addEventListener('click', () => flip(b, b.getAttribute('aria-expanded') !== 'true'));
      });
      function next() {
        const pending = steps(slides[cur]).find(st => !st.classList.contains('shown'));
        if (pending) { pending.classList.add('shown'); syncFrames(); return; }
        const vis = visible(), pos = vis.indexOf(cur);
        if (pos < vis.length - 1) show(vis[pos + 1]);
      }
      function prev() {
        const shown = steps(slides[cur]).filter(st => st.classList.contains('shown'));
        if (shown.length) { shown[shown.length - 1].classList.remove('shown'); syncFrames(); return; }
        const vis = visible(), pos = vis.indexOf(cur);
        if (pos > 0) show(vis[pos - 1], { fromEnd: true });
      }
      function renderNotes() {
        const src = slides[cur].querySelector('.notes-src');
        notes.innerHTML = src ? src.innerHTML : '<p>No notes for this slide.</p>';
      }
      function buildIndex() {
        const groups = {};
        slides.forEach((s, i) => { (groups[s.dataset.group || 'Other'] ||= []).push(i); });
        index.innerHTML = '<h2>Slides</h2>' + Object.entries(groups).map(([g, is]) =>
          `<div class="group"><h3>${g}</h3>${is.map(i => `<button type="button" data-go="${i}"><span class="i">${String(i + 1).padStart(2, '0')}</span>${slides[i].dataset.title || ''}${slides[i].dataset.deep !== undefined ? '<span class="d">Deep dive</span>' : ''}</button>`).join('')}</div>`).join('');
        index.querySelectorAll('[data-go]').forEach(b => b.onclick = () => { index.hidden = true; show(+b.dataset.go, { fromEnd: true }); });
      }
      function resolve(h) {
        if (/^\d+$/.test(h)) { const n = +h; return n >= 1 && n <= slides.length ? n - 1 : -1; }
        return slides.findIndex(s => s.id === h || s.dataset.anchor === h);
      }
      function goHash() {
        const i = resolve(decodeURIComponent(location.hash.slice(1)));
        if (i < 0) return false;
        if (i !== cur || !slides[cur].classList.contains('is-active')) show(i, { fromEnd: true, nav: 'replace' });
        return true;
      }

      document.addEventListener('keydown', e => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const k = e.key;
        if (['ArrowRight', 'PageDown', ' ', 'Enter'].includes(k)) { e.preventDefault(); if (e.shiftKey) { steps(slides[cur]).forEach(s => s.classList.add('shown')); syncFrames(); } next(); }
        else if (['ArrowLeft', 'PageUp', 'Backspace'].includes(k)) { e.preventDefault(); prev(); }
        else if (k === 'Home') show(visible()[0]);
        else if (k === 'End') show(visible().at(-1), { fromEnd: true });
        else if (k === 'f' || k === 'F') { if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => {}); else document.exitFullscreen?.(); }
        else if (k === 'n' || k === 'N') notes.hidden = !notes.hidden;
        else if (k === 'g' || k === 'G' || (k === 'Escape' && !index.hidden)) index.hidden = !index.hidden;
        else if (k === 's' || k === 'S') { short = !short; store.set('deck-short', short ? '1' : '0'); show(cur, { fromEnd: true }); }
      });
      stage.addEventListener('click', e => {
        const a = e.target.closest('a[href^="#"]');
        if (a) { e.preventDefault(); const i = resolve(a.getAttribute('href').slice(1)); if (i >= 0) show(i, { fromEnd: true }); return; }
        if (e.target.closest('a, button, video, [data-noadvance]')) return;
        (e.clientX > window.innerWidth / 3 ? next : prev)();
      });
      let tx = null;
      stage.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
      stage.addEventListener('touchend', e => { if (tx == null) return; const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 40) (dx < 0 ? next : prev)(); tx = null; });
      window.addEventListener('resize', fit);
      window.addEventListener('hashchange', goHash);
      window.addEventListener('popstate', goHash);

      fit(); buildIndex();
      if (!goHash()) show(0, { nav: 'replace' });
    })();
  </script>
</body>
</html>
